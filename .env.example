# Copy to .env (never committed) and fill in.  run.py reads it; real
# environment variables take precedence.

# anthropic (default) = Claude drives the tiers via tool use; offline = follow
# the YAML playbook deterministically (no network, no key).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional overrides
# LAB_WORK_DIR=        # where sim state, logs and reports go (default: sim/)
# KB_INDEX_DIR=        # prebuilt index folder (default: kb/index)
# KB_MODEL_CACHE=      # embedding model cache (default: knowledge_base/.model_cache)
# TESSERACT_CMD=       # only for building the index: path to tesseract.exe
